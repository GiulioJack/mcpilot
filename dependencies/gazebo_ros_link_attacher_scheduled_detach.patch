+
+  bool GazeboRosLinkAttacher::scheduled_detach_callback(
+      gazebo_ros_link_attacher::ScheduledDetach::Request &req,
+      gazebo_ros_link_attacher::ScheduledDetach::Response &res)
+  {
+    std::unique_lock<std::mutex> lock(this->scheduled_detach_mutex_);
+
+    if (this->scheduled_detach_active_)
+    {
+      res.ok = false;
+      res.actual_detach_sim_time = 0.0;
+      res.message = "another scheduled detach is already pending";
+      ROS_ERROR_STREAM("Scheduled detach rejected: " << res.message);
+      return true;
+    }
+
+    const double now = this->world->SimTime().Double();
+    this->scheduled_model1_ = req.model_name_1;
+    this->scheduled_link1_ = req.link_name_1;
+    this->scheduled_model2_ = req.model_name_2;
+    this->scheduled_link2_ = req.link_name_2;
+    this->scheduled_detach_deadline_ = req.detach_sim_time;
+    this->scheduled_detach_actual_time_ = 0.0;
+    this->scheduled_detach_result_ = false;
+    this->scheduled_detach_completed_ = false;
+    this->scheduled_detach_active_ = true;
+
+    ROS_INFO_STREAM("Scheduled detach registered for "
+                    << this->scheduled_model2_ << " at sim time "
+                    << this->scheduled_detach_deadline_ << " s (now "
+                    << now << " s)");
+
+    // The callback deliberately waits for the Gazebo update thread to execute
+    // the detach.  Waiting here does not determine the release timestamp; it
+    // only lets the caller receive the *actual* simulator time at which the
+    // joint was detached.
+    while (!this->scheduled_detach_completed_ && ros::ok())
+      this->scheduled_detach_cv_.wait(lock);
+
+    if (!this->scheduled_detach_completed_)
+    {
+      this->scheduled_detach_active_ = false;
+      res.ok = false;
+      res.actual_detach_sim_time = 0.0;
+      res.message = "ROS shutdown before scheduled detach completed";
+      return true;
+    }
+
+    res.ok = this->scheduled_detach_result_;
+    res.actual_detach_sim_time = this->scheduled_detach_actual_time_;
+    res.message = res.ok ? "scheduled detach completed"
+                         : "scheduled detach reached deadline but joint detach failed";
+    return true;
+  }
+
+
+  void GazeboRosLinkAttacher::on_world_update(const common::UpdateInfo &_info)
+  {
+    std::unique_lock<std::mutex> lock(this->scheduled_detach_mutex_);
+    if (!this->scheduled_detach_active_ || this->scheduled_detach_completed_)
+      return;
+
+    const double sim_time = _info.simTime.Double();
+    if (sim_time + 1e-12 < this->scheduled_detach_deadline_)
+      return;
+
+    const std::string model1 = this->scheduled_model1_;
+    const std::string link1 = this->scheduled_link1_;
+    const std::string model2 = this->scheduled_model2_;
+    const std::string link2 = this->scheduled_link2_;
+
+    // WorldUpdateBegin executes in the simulator update thread.  The timestamp
+    // below is therefore the first physics step whose simulation time is at or
+    // after the requested deadline.
+    // We are already running inside Gazebo's WorldUpdateBegin callback.
+    // Do NOT call detach(), because detach() acquires the physics update
+    // mutex for ROS service-thread safety; reacquiring it from the simulator
+    // update thread can deadlock.  Detach the already-known joint directly.
+    fixedJoint scheduled_joint;
+    bool ok = false;
+    if (this->getJoint(model1, link1, model2, link2, scheduled_joint))
+    {
+      scheduled_joint.joint->Detach();
+      ok = true;
+    }
+
+    this->scheduled_detach_actual_time_ = sim_time;
+    this->scheduled_detach_result_ = ok;
+    this->scheduled_detach_completed_ = true;
+    this->scheduled_detach_active_ = false;
+
+    ROS_INFO_STREAM("Scheduled detach " << (ok ? "executed" : "FAILED")
+                    << " for " << model2
+                    << " | target=" << this->scheduled_detach_deadline_
+                    << " s | actual=" << sim_time
+                    << " s | overshoot="
+                    << 1000.0 * (sim_time - this->scheduled_detach_deadline_)
+                    << " ms");
+
+    lock.unlock();
+    this->scheduled_detach_cv_.notify_all();
+  }
+
 }
